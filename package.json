{
  "name": "questxlm",
  "version": "1.0.0",
  "description": "Decentralized learn-to-earn protocol on Stellar Soroban",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:oracle\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:oracle": "cd oracle && npm run dev",
    "build": "npm run build:frontend && npm run build:oracle",
    "build:frontend": "cd frontend && npm run build",
    "build:oracle": "cd oracle && npm run build",
    "build:contract": "cd contract && cargo build --target wasm32-unknown-unknown --release",
    "test": "npm run test:contract && npm run test:oracle",
    "test:contract": "cd contract && cargo test",
    "test:oracle": "cd oracle && npm test",
    "test:integration": "node scripts/test-integration.js",
    "lint": "npm run lint:frontend && npm run lint:oracle",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:oracle": "cd oracle && npm run lint",
    "format": "npm run format:frontend && npm run format:oracle",
    "format:frontend": "cd frontend && npm run format || true",
    "format:oracle": "cd oracle && npm run format",
    "install:all": "npm install && cd frontend && npm install && cd ../oracle && npm install",
    "deploy:testnet": "node scripts/deploy.js --testnet",
    "deploy:mainnet": "node scripts/deploy.js --mainnet",
    "start:docker": "docker-compose up -d",
    "stop:docker": "docker-compose down",
    "logs:docker": "docker-compose logs -f",
    "clean": "npm run clean:frontend && npm run clean:oracle && npm run clean:contract",
    "clean:frontend": "cd frontend && rm -rf .next node_modules",
    "clean:oracle": "cd oracle && rm -rf node_modules",
    "clean:contract": "cd contract && cargo clean",
    "setup:dev": "npm run install:all && npm run build:contract",
    "health:check": "node scripts/health-check.js",
    "fund:treasury": "node scripts/fund-treasury.js",
    "backup:deployment": "node scripts/backup-deployment.js",
    "docs:generate": "node scripts/generate-docs.js",
    "security:audit": "npm audit --recursive",
    "precommit": "npm run lint && npm run test"
  },
  "workspaces": [
    "frontend",
    "oracle"
  ],
  "keywords": [
    "stellar",
    "soroban",
    "blockchain",
    "education",
    "learn-to-earn",
    "defi",
    "smart-contracts",
    "web3"
  ],
  "author": "QuestXLM Team <team@questxlm.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stellar-ecosystem/questxlm.git"
  },
  "bugs": {
    "url": "https://github.com/stellar-ecosystem/questxlm/issues"
  },
  "homepage": "https://questxlm.org",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@stellar/stellar-sdk": "^12.0.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "volta": {
    "node": "18.19.1",
    "npm": "9.2.0"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/questxlm"
  }
}