{
  "name": "questxlm-oracle",
  "version": "1.0.0",
  "description": "Decentralized oracle service for QuestXLM answer verification",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "build": "echo 'No build step required'",
    "docker:build": "docker build -t questxlm-oracle .",
    "docker:run": "docker run -p 3001:3001 questxlm-oracle"
  },
  "keywords": [
    "stellar",
    "soroban",
    "oracle",
    "blockchain",
    "education",
    "verification"
  ],
  "author": "QuestXLM Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "@stellar/stellar-sdk": "^12.0.0",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "crypto": "^1.0.1",
    "node-cache": "^5.1.2",
    "prometheus-client": "^15.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stellar-ecosystem/questxlm.git"
  },
  "bugs": {
    "url": "https://github.com/stellar-ecosystem/questxlm/issues"
  },
  "homepage": "https://questxlm.org"
}